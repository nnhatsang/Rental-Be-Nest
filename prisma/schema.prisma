// Prisma schema for the admin-first rental management system.
// Phase 1 focuses on manual admin operations: create orders, assign equipment,
// record payments, hand over items, receive returns, and settle balances.

// Checklist for schema design:
// pnpm prisma format
// pnpm prisma validate

// Fresh development setup:
// pnpm prisma migrate reset --skip-seed
// pnpm prisma migrate dev --name init --create-only
// pnpm prisma migrate dev
// pnpm prisma generate
// pnpm db:seed
// pnpm prisma migrate reset   // xử lý reset db phía local (k nên re)

// Rental order validation flow:
// 2. Check ngày đó có mở cửa trong StoreBusinessHour không
// 3. Check khoảng thuê có đụng StoreClosure không
// 4. Check asset/product availability
// 5. Tạo RentalOrder và snapshot policy vào order

// StoreBusinessHour = weekly opening hours.
// StoreClosure = holiday/off/maintenance windows.
// RentalOrder = snapshot of the policy values applied to a specific order.

// check toan bo phan prisma ok k
// pnpm.cmd exec prisma format
// pnpm.cmd exec prisma generate
// pnpm.cmd exec prisma validate
// pnpm.cmd typecheck
// pnpm.cmd build

// ne an toan thi migrate
// pnpm exec prisma migrate deploy tránh apply tránh reset
// pnpm.cmd prisma migrate dev
generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  moduleFormat    = "commonjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, btree_gist]
}

model User {
  /// Primary user id.
  id             String             @id @default(uuid(7)) @db.Uuid
  /// Login email, unique per staff/admin account.
  email          String             @unique
  /// Hashed password, never store raw password.
  passwordHash   String
  /// Display name shown in admin screens and audit logs.
  fullName       String
  /// Optional staff phone number.
  phone          String?
  /// Normalized text for accent-insensitive admin search.
  searchText     String             @default("")
  /// Login/activity status for this staff/admin account.
  activityStatus UserActivityStatus @default(ACTIVE)
  /// Last successful login time.
  lastLoginAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  createdBy      String?            @map("created_by") @db.Uuid
  updatedBy      String?            @map("updated_by") @db.Uuid
  deletedBy      String?            @map("deleted_by") @db.Uuid
  roles          UserRole[]

  @@index([email])
  @@index([activityStatus])
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "User_searchText_trgm_idx", type: Gin)
  @@index([deletedAt])
}

model Role {
  /// Primary role id.
  id          String           @id @default(uuid(7)) @db.Uuid
  /// Stable role code, for example ADMIN, MANAGER, STAFF, VIEWER.
  code        String           @unique
  /// Human-readable role name.
  name        String
  /// Optional role description.
  description String?
  /// System roles should not be deleted from admin UI.
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  /// Primary permission id.
  id          String           @id @default(uuid(7)) @db.Uuid
  /// Stable permission code, for example orders.create or products.update.
  code        String           @unique
  /// Human-readable permission name.
  name        String
  /// Optional permission description.
  description String?
  /// Permission creation time.
  createdAt   DateTime         @default(now())
  /// Last permission update time.
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  /// User receiving the role.
  userId       String   @db.Uuid
  /// Role assigned to the user.
  roleId       String   @db.Uuid
  /// When this role was assigned.
  assignedAt   DateTime @default(now())
  /// User id that assigned this role, stored for audit.
  assignedById String?
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  /// Role receiving the permission.
  roleId       String     @db.Uuid
  /// Permission granted to the role.
  permissionId String     @db.Uuid
  /// When this permission was granted to the role.
  grantedAt    DateTime   @default(now())
  /// User id that granted this permission, stored for audit.
  grantedById  String?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Customer {
  /// Primary customer id.
  id             String         @id @default(uuid(7)) @db.Uuid
  /// Optional customer code for internal lookup.
  code           String?        @unique
  /// Customer full name.
  name           String
  /// Customer phone number.
  phone          String?
  /// Customer email.
  email          String?
  /// Customer address for delivery or contract.
  address        String?
  /// Citizen id/passport number, if required for deposit/contract.
  identityNumber String?
  /// Social contact such as Facebook/Zalo URL or handle.
  socialContact  String?
  /// Internal customer notes.
  notes          String?
  /// Customer account/relationship status.
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  createdBy      String?        @map("created_by") @db.Uuid
  updatedBy      String?        @map("updated_by") @db.Uuid
  deletedBy      String?        @map("deleted_by") @db.Uuid
  searchText     String         @default("")
  orders         RentalOrder[]

  @@index([phone])
  @@index([email])
  @@index([name])
  @@index([status])
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "Customer_searchText_trgm_idx", type: Gin)
}

model ProductCategory {
  /// Primary category id.
  id         String                      @id @default(uuid(7)) @db.Uuid
  /// Category name, for example Camera, Lens, Light.
  name       String
  /// Optional URL/admin slug.
  slug       String?                     @unique
  /// Whether this category is visible/usable.
  isActive   Boolean                     @default(true)
  searchText String                      @default("")
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  deletedAt  DateTime?
  createdBy  String?                     @map("created_by") @db.Uuid
  updatedBy  String?                     @map("updated_by") @db.Uuid
  deletedBy  String?                     @map("deleted_by") @db.Uuid
  products   ProductCategoryAssignment[]

  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "ProductCategory_searchText_trgm_idx", type: Gin)
}

model Brand {
  /// Primary brand id.
  id         String    @id @default(uuid(7)) @db.Uuid
  /// Brand name, for example Sony, Canon, DJI.
  name       String
  /// Optional URL/admin slug.
  slug       String?   @unique
  /// Whether this brand is visible/usable.
  isActive   Boolean   @default(true)
  searchText String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedBy  String?   @map("deleted_by") @db.Uuid
  products   Product[]

  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "Brand_searchText_trgm_idx", type: Gin)
}

model Product {
  /// Primary product id; represents the rentable product type/model.
  id                  String                      @id @default(uuid(7)) @db.Uuid
  /// Product name, for example Sony A7 IV.
  name                String
  /// Unique product SKU.
  sku                 String                      @unique
  /// Optional product description.
  description         String?
  /// Included accessories or package contents.
  includedAccessories String?
  /// Usage guide or handover note for staff/customer.
  usageGuide          String?
  /// Optional product brand.
  brandId             String?                     @db.Uuid
  /// Full-day rental price.
  dailyPrice          Decimal                     @db.Decimal(12, 2)
  /// Half-day rental price.
  halfDayPrice        Decimal                     @db.Decimal(12, 2)
  /// Hourly overage price for extra hours.
  hourlyOveragePrice  Decimal?                    @db.Decimal(12, 2)
  /// Standard deposit amount.
  depositAmount       Decimal                     @db.Decimal(12, 2)
  /// Replacement value used for lost/severe damage cases.
  replacementValue    Decimal?                    @db.Decimal(12, 2)
  /// Whether this product can be used in new orders.
  isActive            Boolean                     @default(true)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  deletedAt           DateTime?
  createdBy           String?                     @map("created_by") @db.Uuid
  updatedBy           String?                     @map("updated_by") @db.Uuid
  deletedBy           String?                     @map("deleted_by") @db.Uuid
  searchText          String                      @default("")
  assetUnits          AssetUnit[]
  brand               Brand?                      @relation(fields: [brandId], references: [id])
  categoryAssignments ProductCategoryAssignment[]
  rentalPriceTiers    ProductRentalPriceTier[]
  rentalOrderLines    RentalOrderLine[]

  @@index([brandId])
  @@index([sku])
  @@index([isActive])
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "Product_searchText_trgm_idx", type: Gin)
}

model ProductCategoryAssignment {
  /// Product/category relation id is represented by the composite primary key.
  productId  String          @db.Uuid
  categoryId String          @db.Uuid
  createdAt  DateTime        @default(now())
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model ProductRentalPriceTier {
  /// Mã định danh chính của bậc giá thuê.
  id         String    @id @default(uuid(7)) @db.Uuid
  /// Sản phẩm áp dụng bậc giá này.
  productId  String    @db.Uuid
  /// Số ngày tối thiểu để áp dụng bậc giá.
  minDays    Int
  /// Số ngày tối đa để áp dụng bậc giá; null nghĩa là không giới hạn.
  maxDays    Int?
  /// Giá thuê mỗi ngày trong bậc này.
  dailyPrice Decimal   @db.Decimal(12, 2)
  /// Tên hiển thị nội bộ, ví dụ "Combo 3-6 ngày".
  name       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedBy  String?   @map("deleted_by") @db.Uuid
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([minDays, maxDays])
}

model AssetUnit {
  /// Primary asset unit id; represents one physical device.
  id               String                  @id @default(uuid(7)) @db.Uuid
  /// Product model/type this unit belongs to.
  productId        String                  @db.Uuid
  /// Optional unique serial number for the physical device.
  serialNumber     String                  @unique
  /// Current operational status of this physical device.
  status           AssetStatus             @default(AVAILABLE)
  /// Current condition of this physical device.
  condition        AssetCondition          @default(GOOD)
  /// Internal note about this device.
  note             String?
  /// Whether this physical unit can be assigned to orders.
  isActive         Boolean                 @default(true)
  searchText       String                  @default("")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  createdBy        String?                 @map("created_by") @db.Uuid
  updatedBy        String?                 @map("updated_by") @db.Uuid
  deletedBy        String?                 @map("deleted_by") @db.Uuid
  product          Product                 @relation(fields: [productId], references: [id])
  assetAllocations RentalAssetAllocation[]

  @@index([productId])
  @@index([status])
  @@index([condition])
  @@index([isActive])
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "AssetUnit_searchText_trgm_idx", type: Gin)
}

model SystemSettings {
  id Int @id @default(1)

  /// Tiền đặt lịch mặc định cho mỗi thiết bị, ví dụ 50.000đ/máy.
  bookingHoldPricePerUnit  Decimal @default(50000) @db.Decimal(12, 2)
  /// Số phút đệm mặc định giữa hai lượt thuê cùng thiết bị.
  bookingBufferTimeMinutes Int     @default(60)
  //số ngày tối đa cho phep thuê
  maxRentalTimeDays        Int     @default(30)
  //số giờ tối đa cho phép trả trễ
  maxLateReturnTimeHours   Int     @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreBusinessHour {
  /// Thứ trong tuần: 0 = Chủ nhật, 1 = Thứ hai, ..., 6 = Thứ bảy.
  dayOfWeek Int      @id
  /// Giờ mở cửa theo định dạng HH:mm, ví dụ 08:00.
  openTime  String
  /// Giờ đóng cửa theo định dạng HH:mm, ví dụ 20:00.
  closeTime String
  /// Ngày này shop có mở cửa hay không.
  isOpen    Boolean  @default(true)
  /// Thời gian tạo cấu hình giờ hoạt động.
  createdAt DateTime @default(now())
  /// Thời gian cập nhật cấu hình giờ hoạt động gần nhất.
  updatedAt DateTime @updatedAt
}

model StoreClosure {
  /// Mã định danh chính của lịch nghỉ/off/bảo trì.
  id        String           @id @default(uuid(7)) @db.Uuid
  /// Thời gian bắt đầu shop nghỉ/off/bảo trì.
  startDate DateTime
  /// Thời gian kết thúc shop nghỉ/off/bảo trì.
  endDate   DateTime
  /// Loại lịch chặn.
  type      StoreClosureType @default(OFF)
  /// Lý do hiển thị cho admin, ví dụ nghỉ lễ hoặc bảo trì thiết bị.
  reason    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@index([startDate, endDate])
  @@index([type])
  @@index([deletedAt])
}

model RentalOrder {
  /// Mã định danh chính của đơn thuê.
  id               String                 @id @default(uuid(7)) @db.Uuid
  /// Mã đơn dễ đọc để admin tra cứu, ví dụ ORD-000001.
  code             String                 @unique
  /// Nguồn tạo đơn; giai đoạn 1 chủ yếu là ADMIN, WEBSITE để dành cho flow khách tự đặt sau này.
  source           OrderSource            @default(ADMIN)
  /// Trạng thái vận hành của đơn thuê.
  status           OrderStatus            @default(CREATED)
  handoverStatus   HandoverStatus         @default(PENDING_PAYMENT)
  returnStatus     ReturnStatus           @default(NOT_RETURNED)
  settlementStatus RentalSettlementStatus @default(NOT_STARTED)
  /// Chính sách thuê được áp dụng khi tạo đơn; order vẫn lưu snapshot để không bị ảnh hưởng khi policy thay đổi.
  settingsSnapshot Json
  policyVersion    String                 @default("v1")
  /// Khách hàng thuê thiết bị.
  customerId       String                 @db.Uuid
  customerSnapshot Json
  startDate        DateTime
  /// Thời gian kết thúc thuê hoặc thời gian khách dự kiến trả máy.
  endDate          DateTime

  /// Thời gian khách nhận máy thực tế do admin nhập hoặc ghi nhận khi bắt đầu thuê.
  actualPickupDate        DateTime?
  /// Thời gian khách trả máy thực tế do admin nhập.
  actualReturnDate        DateTime?
  /// Hình thức nhận máy: khách nhận tại cửa hàng hoặc cửa hàng giao.
  pickupMethod            PickupMethod         @default(PICKUP_AT_STORE)
  /// Địa chỉ giao máy nếu pickupMethod là DELIVERY.
  deliveryAddress         String?
  /// Phí giao/nhận máy thu từ khách.
  deliveryFeeTotal        Decimal              @default(0) @db.Decimal(12, 2)
  /// Tổng tiền thuê cửa hàng sẽ giữ lại nếu không phát sinh hoàn/đền.
  rentalFeeTotal          Decimal              @default(0) @db.Decimal(12, 2)
  /// Snapshot tổng tiền đặt lịch ban đầu để giữ máy, thường lấy từ RentalPolicy * số lượng thiết bị.
  bookingHoldTotal        Decimal              @default(0) @db.Decimal(12, 2)
  /// Tổng phí trả trễ được tính sau khi khách trả máy.
  lateFeeTotal            Decimal              @default(0) @db.Decimal(12, 2)
  paidTotal               Decimal              @default(0) @db.Decimal(12, 2)
  actualRefundTotal       Decimal              @default(0) @db.Decimal(12, 2)
  securityDepositTotal    Decimal              @default(0) @db.Decimal(12, 2)
  totalCustomerObligation Decimal              @default(0) @db.Decimal(12, 2)
  amountDueAtBooking      Decimal              @default(0) @db.Decimal(12, 2)
  amountDueBeforeHandover Decimal              @default(0) @db.Decimal(12, 2)
  refundDue               Decimal              @default(0) @db.Decimal(12, 2)
  additionalChargeDue     Decimal              @default(0) @db.Decimal(12, 2)
  damageCompensationTotal Decimal              @default(0) @db.Decimal(12, 2)
  /// Ghi chú hiển thị cho khách hoặc dùng trên hợp đồng.
  note                    String?
  /// Ghi chú nội bộ chỉ dành cho admin/staff.
  internalNote            String?
  /// Lý do hủy đơn nếu đơn bị hủy.
  cancelReason            String?
  /// Admin/staff được phân công xử lý đơn.
  searchText              String               @default("")
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  deletedAt               DateTime?
  createdBy               String               @map("created_by") @db.Uuid
  updatedBy               String?              @map("updated_by") @db.Uuid
  deletedBy               String?              @map("deleted_by") @db.Uuid
  statusHistories         OrderStatusHistory[]
  logs                    RentalOrderLog[]
  customer                Customer             @relation(fields: [customerId], references: [id])
  lines                   RentalOrderLine[]
  charges                 RentalOrderCharge[]
  paymentTransactions     PaymentTransaction[]
  refunds                 Refund[]
  inspections             RentalInspection[]
  incidents               RentalIncident[]
  quoteId                 String?              @unique @db.Uuid
  quote                   RentalOrderQuote?    @relation(fields: [quoteId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([createdBy])
  @@index([startDate, endDate])
  @@index([startDate])
  @@index([status, startDate, deletedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "RentalOrder_searchText_trgm_idx", type: Gin)
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  createdAt  DateTime     @default(now())
  createdBy  String       @map("created_by") @db.Uuid

  order RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([toStatus])
  @@index([createdAt])
}

model RentalOrderLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderId       String   @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  entity        String
  changes       Json
  note          String?
  actorSnapshot Json?
  createdAt     DateTime @default(now())

  order RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model RentalOrderQuote {
  id               String       @id @default(uuid(7)) @db.Uuid
  customerId       String?      @db.Uuid
  source           OrderSource  @default(ADMIN)
  startDate        DateTime
  endDate          DateTime
  pickupMethod     PickupMethod
  deliveryAddress  String?
  requestSnapshot  Json
  responseSnapshot Json
  policyVersion    String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime     @default(now())
  createdBy        String?      @db.Uuid
  order            RentalOrder?

  @@index([expiresAt])
  @@index([customerId])
}

model RentalOrderLine {
  id                    String   @id @default(uuid(7)) @db.Uuid
  orderId               String   @db.Uuid
  productId             String   @db.Uuid
  quantity              Int
  unitRentalFee         Decimal  @db.Decimal(12, 2)
  unitDepositAmount     Decimal  @db.Decimal(12, 2)
  unitBookingHoldAmount Decimal  @default(0) @db.Decimal(12, 2)
  lineRentalTotal       Decimal  @db.Decimal(12, 2)
  lineDepositTotal      Decimal  @db.Decimal(12, 2)
  lineBookingHoldTotal  Decimal  @default(0) @db.Decimal(12, 2)
  pricingSnapshot       Json
  accessoriesSnapshot   Json?
  note                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  order       RentalOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product                 @relation(fields: [productId], references: [id])
  allocations RentalAssetAllocation[]
  charges     RentalOrderCharge[]

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
}

model RentalAssetAllocation {
  id             String                 @id @default(uuid(7)) @db.Uuid
  orderLineId    String                 @db.Uuid
  assetUnitId    String                 @db.Uuid
  source         RentalAllocationSource @default(ADMIN_SELECTED)
  status         RentalAllocationStatus @default(REQUESTED)
  startDate      DateTime
  endDate        DateTime
  blockedEndDate DateTime
  allocatedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  orderLine       RentalOrderLine        @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  assetUnit       AssetUnit              @relation(fields: [assetUnitId], references: [id])
  inspectionItems RentalInspectionItem[]
  incidents       RentalIncident[]

  @@unique([orderLineId, assetUnitId])
  @@index([assetUnitId, startDate, blockedEndDate])
  @@index([status])
}

model RentalOrderCharge {
  id          String             @id @default(uuid(7)) @db.Uuid
  orderId     String             @db.Uuid
  orderLineId String?            @db.Uuid
  kind        RentalChargeKind
  amount      Decimal            @db.Decimal(12, 2)
  status      RentalChargeStatus @default(OPEN)
  refundable  Boolean            @default(false)
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  order              RentalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine          RentalOrderLine?    @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  paymentAllocations PaymentAllocation[]

  @@index([orderId, kind])
  @@index([status])
}

model PaymentTransaction {
  id             String                   @id @default(uuid(7)) @db.Uuid
  orderId        String                   @db.Uuid
  direction      PaymentDirection         @default(INBOUND)
  amount         Decimal                  @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentTransactionStatus @default(PENDING)
  referenceCode  String?
  idempotencyKey String?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  createdBy      String                   @db.Uuid

  order       RentalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]
  refund      Refund?

  @@unique([orderId, idempotencyKey])
  @@index([orderId, status])
  @@index([referenceCode])
}

model PaymentAllocation {
  paymentId String   @db.Uuid
  chargeId  String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  payment PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  RentalOrderCharge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@id([paymentId, chargeId])
  @@index([chargeId])
}

model Refund {
  id            String             @id @default(uuid(7)) @db.Uuid
  orderId       String             @db.Uuid
  paymentId     String?            @unique @db.Uuid
  amount        Decimal            @db.Decimal(12, 2)
  status        RentalRefundStatus @default(PENDING)
  method        PaymentMethod
  referenceCode String?
  note          String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdBy     String             @db.Uuid

  order   RentalOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment PaymentTransaction? @relation(fields: [paymentId], references: [id])

  @@index([orderId, status])
}

model RentalInspection {
  id          String               @id @default(uuid(7)) @db.Uuid
  orderId     String               @db.Uuid
  type        RentalInspectionType
  inspectedBy String               @db.Uuid
  inspectedAt DateTime             @default(now())
  note        String?

  order RentalOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items RentalInspectionItem[]

  @@unique([orderId, type])
}

model RentalInspectionItem {
  id           String                    @id @default(uuid(7)) @db.Uuid
  inspectionId String                    @db.Uuid
  allocationId String                    @db.Uuid
  condition    RentalInspectionCondition
  note         String?

  inspection  RentalInspection            @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  allocation  RentalAssetAllocation       @relation(fields: [allocationId], references: [id])
  accessories RentalInspectionAccessory[]

  @@unique([inspectionId, allocationId])
}

model RentalInspectionAccessory {
  id               String                @id @default(uuid(7)) @db.Uuid
  inspectionItemId String                @db.Uuid
  name             String
  expectedQuantity Int
  actualQuantity   Int
  status           RentalAccessoryStatus
  note             String?

  inspectionItem RentalInspectionItem @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)

  @@index([inspectionItemId])
}

model RentalIncident {
  id           String               @id @default(uuid(7)) @db.Uuid
  orderId      String               @db.Uuid
  allocationId String?              @db.Uuid
  type         RentalIncidentType
  amount       Decimal              @default(0) @db.Decimal(12, 2)
  note         String?
  status       RentalIncidentStatus @default(OPEN)
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  createdBy    String               @db.Uuid

  order      RentalOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocation RentalAssetAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)

  @@index([orderId, type])
  @@index([allocationId])
}

model EmailLayout {
  id         String          @id @default(uuid(7)) @db.Uuid
  key        String          @unique
  name       String
  htmlLayout String
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  createdBy  String?         @db.Uuid
  updatedBy  String?         @db.Uuid
  templates  EmailTemplate[]

  @@index([key])
  @@index([isActive])
}

model EmailTemplate {
  id          String       @id @default(uuid(7)) @db.Uuid
  key         String       @unique
  name        String
  layoutId    String?      @db.Uuid
  subject     String
  htmlBody    String
  variables   Json?
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  layout      EmailLayout? @relation(fields: [layoutId], references: [id])

  @@index([key])
  @@index([layoutId])
  @@index([isActive])
}

enum CustomerStatus {
  /// Customer can create/rent orders.
  ACTIVE
  /// Customer is inactive but historical data remains.
  INACTIVE
  /// Customer is blocked from new rental orders.
  BLOCKED
}

enum UserActivityStatus {
  /// User can log in normally.
  ACTIVE
  /// User is banned from logging in.
  BANNED
  /// User is temporarily locked and must contact an administrator.
  LOCKED
  /// User is inactive or not activated.
  INACTIVE
}

enum AssetStatus {
  AVAILABLE // Có thể assign
  MAINTENANCE // Đang bảo trì
  LOST // Thất lạc
}

enum AssetCondition {
  /// Brand-new condition.
  NEW
  /// Good working condition.
  GOOD
  /// Fair condition with visible wear.
  FAIR
  /// Damaged but not necessarily lost.
  DAMAGED
}

enum StoreClosureType {
  /// Shop nghỉ/off theo lịch.
  OFF
  /// Shop nghỉ lễ.
  HOLIDAY
  /// Shop bảo trì hoặc tạm ngưng vận hành.
  MAINTENANCE
  /// Shop bận sự kiện hoặc lịch nội bộ.
  INTERNAL_EVENT
  /// Lý do khác.
  OTHER
}

enum OrderSource {
  /// Order created manually by admin/staff.
  ADMIN
  /// Order created from future website checkout.
  WEBSITE
}

enum OrderStatus {
  CREATED
  CONFIRMED
  RENTING
  RETURNED
  DONE
  CANCELLED
  DISPUTED
}

enum HandoverStatus {
  PENDING_PAYMENT
  READY
  HANDED_OVER
}

enum ReturnStatus {
  NOT_RETURNED
  RETURNED
  INSPECTED
}

enum RentalSettlementStatus {
  NOT_STARTED
  PAYMENT_DUE
  REFUND_DUE
  SETTLED
  DISPUTED
}

enum RentalChargeKind {
  BOOKING_HOLD
  RENTAL_FEE
  LATE_FEE
  DELIVERY_FEE
  SECURITY_DEPOSIT
  DAMAGE_COMPENSATION
  CANCELLATION_FEE
  OTHER_CHARGE
}

enum RentalChargeStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  WAIVED
  CANCELLED
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum RentalRefundStatus {
  PENDING
  PROCESSING
  REFUNDED
  FAILED
}

enum RentalAllocationSource {
  ADMIN_SELECTED
  AUTO_ALLOCATED
}

enum RentalAllocationStatus {
  REQUESTED
  RESERVED
  HANDED_OVER
  RETURNED
  RELEASED
}

enum RentalInspectionType {
  HANDOVER
  RETURN
}

enum RentalInspectionCondition {
  GOOD
  DAMAGED
  MISSING
  NEEDS_MAINTENANCE
}

enum RentalAccessoryStatus {
  OK
  MISSING
  DAMAGED
}

enum RentalIncidentType {
  DAMAGE
  LOSS
  MISSING_ACCESSORY
  LATE_RETURN
}

enum RentalIncidentStatus {
  OPEN
  WAIVED
  CHARGED
  RESOLVED
}

enum PickupMethod {
  /// Customer receives equipment at the store.
  PICKUP_AT_STORE
  /// Shop delivers equipment to customer.
  DELIVERY
}

enum PaymentMethod {
  /// Cash payment.
  CASH
  /// Bank transfer payment.
  BANK_TRANSFER
  /// Card payment.
  CARD
  /// E-wallet payment.
  E_WALLET
  /// Other payment method.
  OTHER
